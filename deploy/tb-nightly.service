[Unit]
Description=toronto-bids nightly: sync, enrich (award summaries, ariba attachments, agency board reports, monthly council), export, publish
Documentation=https://github.com/CivicTechTO/toronto-bids/blob/main/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/toronto-bids/scrapers
# Keep data outside the git checkout so `git pull` cannot touch it.
Environment=TB_DATA_DIR=%h/tb-data
# Optional credentials file (mode 0600, not in git): TB_SLACK_WEBHOOK, GH_TOKEN, ARIBA_*, ANTHROPIC_API_KEY.
EnvironmentFile=-%h/.config/toronto-bids/tb.env
ExecStart=%h/toronto-bids/deploy/tb-nightly-run.sh
# Generous ceiling for inline browser captures and scrapes.
TimeoutStartSec=3h
