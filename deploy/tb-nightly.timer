[Unit]
Description=Run toronto-bids nightly
Documentation=https://github.com/CivicTechTO/toronto-bids/blob/main/docs/superpowers/specs/2026-07-17-deployment-design.md

[Timer]
# The box runs on UTC, so a bare `OnCalendar=daily` would fire at 20:00 Toronto. systemd >=252
# accepts a timezone here and owns the DST arithmetic; verified on the host with
# `systemd-analyze calendar`.
#
# Tue..Sat, not every day (#180): a 05:30 run reports on the PREVIOUS day, and the City doesn't
# transact on weekends — Sat covers Fri (a full business day, keep it), Sun covers Sat (skip),
# Mon covers Sun (skip), Tue covers Mon (keep). Measured: zero new rows on both Sun and Mon
# across an 11-day window, and the City's own Ariba close_date values never land on a weekend
# at all (n=48). Accepted tradeoff: a solicitation closing Monday at noon whose window opened
# only over the weekend gets its last capture chance at Saturday's run, ~2.5 days out — the
# Ariba capture step is idempotent/resumable, so this only matters for what a single run misses
# entirely, not for anything already captured on a prior day.
OnCalendar=Tue..Sat *-*-* 05:30:00 America/Toronto
# Don't hit the City's endpoints at a round number.
RandomizedDelaySec=30m
# A home server is not assumed to be up: run a missed job on the next boot.
Persistent=true

[Install]
WantedBy=timers.target
