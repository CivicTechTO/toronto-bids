[Unit]
Description=Run toronto-bids nightly
Documentation=https://github.com/CivicTechTO/toronto-bids/blob/main/deploy/README.md

[Timer]
# Explicit timezone avoids UTC/DST drift. Tue..Sat covers Mon..Fri business days (City posts nothing on weekends).
OnCalendar=Tue..Sat *-*-* 05:30:00 America/Toronto
RandomizedDelaySec=30m
# Run a missed job on next boot.
Persistent=true

[Install]
WantedBy=timers.target
