# Copy to scrapers/.env (gitignored — this repo is public, real credentials never go in it)
# and fill in. Used only by `tb enrich-ariba-attachments --capture` (#117) to log the headed
# browser into a SAP Ariba supplier account so the Respond gate opens. Respond registers our
# account as an event participant for archival access (authorized by PMMD); a bid is never
# submitted. The account must not have MFA/2FA — an unattended login cannot answer a challenge.
ARIBA_USERNAME=your-ariba-supplier-username
ARIBA_PASSWORD=your-ariba-supplier-password

# Direct Claude API key for uncached document extraction. On the server, use
# ~/.config/toronto-bids/tb.env (0600). Existing cached documents need no API key.
# Included Claude subscription API credits apply to the linked Console organization.
ANTHROPIC_API_KEY=your-anthropic-api-key
TB_LLM_PROVIDER=anthropic
# Conservative default until a cheaper model passes real-document evaluation.
TB_CLAUDE_MODEL=claude-sonnet-5-5
# Local calendar-month USD guard; zero stops new requests. Also set a Console
# workspace spending limit: the local ledger cannot control other applications.
TB_LLM_MONTHLY_USD=20

# Legacy opt-in only: TB_LLM_PROVIDER=openrouter uses this instead. No automatic
# provider fallback; OpenRouter requests do not consume direct Claude API credits.
# OPENROUTER_API_KEY=your-openrouter-api-key
