# Copy to scrapers/.env (gitignored — this repo is public, real credentials never go in it)
# and fill in. Used only by `tb enrich-ariba-attachments --capture` (#117) to log the headed
# browser into a SAP Ariba supplier account so the Respond gate opens. Respond registers our
# account as an event participant for archival access (authorized by PMMD); a bid is never
# submitted. The account must not have MFA/2FA — an unattended login cannot answer a challenge.
ARIBA_USERNAME=your-ariba-supplier-username
ARIBA_PASSWORD=your-ariba-supplier-password

# OpenRouter API key for the LLM bid extraction every store step now goes through
# (`extract_and_backfill`: award summaries, TRCA/EP/Zoo board reports, committee, composite).
# Needed whenever a document is not yet in the extraction cache; without it those steps fail
# for any uncached document (the PDFs are still downloaded and archived, and are extracted once
# a real key is set). This placeholder reads as unset. On the server, put the real key in
# ~/.config/toronto-bids/tb.env instead — see deploy/README.md §3.
OPENROUTER_API_KEY=your-openrouter-api-key
